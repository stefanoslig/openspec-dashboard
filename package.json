{
  "name": "openspec-desk",
  "version": "0.2.0",
  "description": "Read-only dashboard for OpenSpec artifacts: run it locally or export a static site.",
  "keywords": [
    "openspec",
    "spec-driven-development",
    "specs",
    "dashboard",
    "viewer",
    "static-site",
    "cli"
  ],
  "homepage": "https://openspec-desk.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanoslig/openspec-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/stefanoslig/openspec-dashboard/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "openspec-desk": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "demo"
  ],
  "scripts": {
    "ng": "ng",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && ng build && tsc -p cli",
    "prestart": "npm run build",
    "start": "node dist/cli/main.js --demo",
    "dev": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "test": "tsc -p cli/tsconfig.test.json && node --test \"cli/*.test.ts\" \"src/**/*.test.ts\"",
    "test:ui": "playwright test",
    "format": "prettier --write src cli tests README.md package.json angular.json proxy.conf.json playwright.config.ts",
    "prepack": "npm run build"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "marked": "^18.0.14",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "diff": "^9.0.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
