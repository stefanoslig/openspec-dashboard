{
  "name": "openspec-dashboard",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "dotnet run --project backend/OpenSpec.Api --no-launch-profile",
    "prestart": "npm run build",
    "start:hosted": "node --env-file=.env scripts/run-backend.mjs",
    "prestart:hosted": "npm run build",
    "build": "ng build",
    "dev": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "serve:api": "dotnet run --project backend/OpenSpec.Api --no-launch-profile",
    "build:api": "dotnet build backend/OpenSpec.Api",
    "db:migrate": "node --env-file=.env scripts/run-backend.mjs --migrate",
    "auth:certificate": "node scripts/run-backend.mjs --create-certificate .secrets/data-protection.pfx",
    "test": "dotnet test backend/OpenSpec.Api.Tests --filter Category!=PostgreSQL",
    "test:db": "node scripts/test-database.mjs",
    "format": "prettier --write src scripts tests README.md package.json angular.json proxy.conf.json playwright.config.ts",
    "format:api": "dotnet format OpenSpec.slnx",
    "test:ui": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "marked": "^18.0.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
