DASHBOARD_MODE=hosted
PUBLIC_ORIGIN=http://127.0.0.1:4310
PORT=4310
GITHUB_CLIENT_ID=replace-with-your-github-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-app-client-secret
GITHUB_APP_SLUG=replace-with-your-github-app-slug
ConnectionStrings__Dashboard="Host=localhost;Port=5432;Database=openspec;Username=openspec;Password=replace-me;GSS Encryption Mode=Disable"
# Generate once with npm run auth:certificate. Use the same file on every instance.
DATA_PROTECTION_CERTIFICATE_PATH=/absolute/path/to/openspec-dashboard/.secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=
